# Porta do backend
PORT=4000

# Segredo para assinar os tokens de sessao (troque por algo aleatorio)
JWT_SECRET=troque-isto-por-uma-string-aleatoria-grande

# Origens permitidas do frontend (separadas por virgula). * = qualquer.
CLIENT_ORIGIN=http://localhost:5173

# Banco de dados:
#  - sem MONGODB_URI  -> usa arquivo local server/data/db.json (bom pra dev)
#  - com MONGODB_URI   -> usa MongoDB (bom pra producao / Render)
# MONGODB_URI=mongodb+srv://usuario:senha@cluster.xxxx.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=elo
