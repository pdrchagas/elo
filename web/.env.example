# URL do backend (deixe vazio para usar a mesma origem em producao)
VITE_API_URL=http://localhost:4000

# TURN opcional — necessario quando os amigos estao atras de NAT restritivo
# e a conexao P2P direta falha. Sem isso funciona na maioria das redes domesticas.
# VITE_TURN_URL=turn:seu-servidor:3478
# VITE_TURN_USERNAME=usuario
# VITE_TURN_CREDENTIAL=senha
