# Build de producao: o frontend e servido pelo proprio backend (mesma origem),
# entao a URL da API fica vazia -> usa window.location.origin.
VITE_API_URL=

# Se voce hospedar o frontend separado do backend, ponha a URL do backend aqui.

# TURN opcional (para amigos atras de NAT restritivo). Exemplo com servico gratuito:
# VITE_TURN_URL=turn:seu-servidor:3478
# VITE_TURN_USERNAME=usuario
# VITE_TURN_CREDENTIAL=senha
